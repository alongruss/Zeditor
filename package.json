{
  "name": "zeditor",
  "version": "0.1.0",
  "private": true,
  "description": "A small visual editor for Zdog illustrations",
  "type": "module",
  "author": "Alon Gruss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alongruss/Zeditor.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:slow": "playwright test --project=slow",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify": "npm run check && npm run test:e2e && npm run test:e2e:slow"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "zdog": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/zdog": "^1.1.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lottie-web": "^5.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
